<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Developer Idea Board - Public Feed</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-950 min-h-screen p-4 sm:p-8 relative text-zinc-300 selection:bg-indigo-500/30 overflow-hidden">

    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-[600px] h-[300px] sm:h-[500px] bg-indigo-600/10 blur-[100px] sm:blur-[120px] pointer-events-none rounded-full z-0"></div>

    <div class="max-w-2xl mx-auto relative z-10 w-full">
        <h1 class="text-2xl sm:text-3xl font-light text-zinc-100 mb-6 sm:mb-10 text-center tracking-wider">Community Ideas</h1>

        <div class="flex flex-col gap-6 overflow-y-auto max-h-[80vh] sm:max-h-[75vh] px-1 sm:px-2 pb-10 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
            
            <% if (ideas.length > 0) { %>
                <% ideas.forEach(idea => { %>
                    <div class="p-5 sm:p-7 rounded-2xl bg-zinc-900/40 border border-zinc-800/60 backdrop-blur-md hover:bg-zinc-900/70 transition-all duration-500 hover:shadow-[0_0_30px_rgba(99,102,241,0.06)] hover:border-indigo-500/20 group">
                        
                        <h2 class="text-lg sm:text-xl font-medium text-zinc-100 group-hover:text-indigo-400 transition-colors duration-300 tracking-wide break-words">
                            <%= idea.heading %>
                        </h2>
                        
                        <p class="text-zinc-400 mt-3 sm:mt-4 text-sm sm:text-base font-light leading-relaxed break-words">
                            <%= idea.content %>
                        </p>
                        
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mt-6 sm:mt-8 pt-4 sm:pt-5 border-t border-zinc-800/50 text-xs sm:text-sm gap-3 sm:gap-0">
                            <div class="flex items-center gap-2 text-zinc-500">
                                <span class="font-light">Posted by</span> 
                                <span class="font-medium text-zinc-300 truncate max-w-[150px] sm:max-w-xs">@<%= idea.user ? idea.user.username : 'Unknown' %></span>
                            </div>
                            
                               <div class="flex flex-row sm:flex-col items-center sm:items-end justify-start gap-3 w-full sm:w-auto mt-2 sm:mt-0">
                        <a href="/like/<%= post._id %>" class="w-full sm:w-auto justify-center group/btn bg-gradient-to-r from-indigo-500/10 to-purple-500/10 hover:from-indigo-500 hover:to-purple-500 border border-purple-500/30 hover:border-transparent text-purple-400 hover:text-white font-medium text-sm rounded-lg px-4 py-2 transition-all duration-300 flex items-center gap-2">
                            <svg class="w-4 h-4 transition-transform group-hover/btn:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                            </svg>
                            <%= post.likes.some(id=> id?.toString() === user?._id?.toString()) ? 'Unlike' : 'Like' %>
                            <span class="flex items-center justify-center min-w-[20px] h-5 px-1.5 ml-1 rounded-md text-xs font-bold bg-purple-500/20 text-purple-300 group-hover/btn:bg-white/20 group-hover/btn:text-white transition-colors">
                                <%= post.likes.length %>
                            </span>
                        </a>
                    </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-16 sm:py-24 border border-zinc-800/50 rounded-2xl bg-zinc-900/20 border-dashed backdrop-blur-sm shadow-inner text-center px-4">
                    <p class="text-zinc-500 font-light text-base sm:text-lg mb-2">The board is quietly waiting.</p>
                    <p class="text-indigo-400/80 text-sm sm:text-base font-medium tracking-wide">Be the first to post an idea.</p>
                </div>
            <% } %>
            
        </div>
    </div>

</body>
</html>