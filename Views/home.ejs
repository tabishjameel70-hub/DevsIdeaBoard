<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | Developer Idea Board</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 min-h-screen text-gray-200 font-sans flex flex-col">

    <nav class="bg-gray-800 border-b border-gray-700 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center">
                    <a href="/"
                        class="text-xl font-bold text-white flex items-center gap-2 hover:text-indigo-400 transition">
                        <span class="text-indigo-500">&lt;/&gt;</span> DevBoard
                    </a>
                </div>
                <div class="flex space-x-4">
                    <a href="/feed"
                        class="px-3 py-2 rounded-md text-sm font-medium bg-gray-900 text-white border border-gray-700">Explore
                        feed</a>
                    <a href="/profile"
                        class="px-3 py-2 rounded-md text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition">My
                        Profile</a>
                    <a href="/logout"
                        class="px-3 py-2 rounded-md text-sm font-medium text-red-400 hover:bg-gray-700 hover:text-red-300 transition">Log
                        Out</a>
                </div>
            </div>
        </div>
    </nav>

    <header class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
            Build the Next <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-500">Big Thing.</span>
        </h1>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto mb-8">
            Discover, pitch, and upvote open-source projects, SaaS ideas, and web apps. If you can type it, we can build
            it together.
        </p>
        <div class="flex justify-center gap-4">
            <a href="/addpost"
                class="px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 hover:-translate-y-1 transform transition duration-200 shadow-lg hover:shadow-indigo-500/30">
                + Pitch New Idea
            </a>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 w-full flex-grow">
        <div class="flex items-center justify-between mb-6 border-b border-gray-700 pb-2">
            <h2 class="text-2xl font-bold text-gray-100">Recent Pitches</h2>
        </div>
        <% user.posts.reverse().forEach(function(post) { %>
            <div
                class="bg-gray-800 rounded-xl p-6 border border-gray-700 shadow-sm hover:border-indigo-500 transition duration-300 mb-6 group">
                <div class="flex justify-between items-start gap-4">
                    <div>
                        <h3 class="text-xl font-bold text-white group-hover:text-indigo-400 transition">
                            <%= post.heading %>
                        </h3>

                        <p class="text-sm text-gray-400 mt-1">Posted by <span class="font-medium text-gray-300">@<%=
                                    user.username %></span></p>

                        <p class="mt-3 text-gray-300 text-sm leading-relaxed">
                            <%= post.content %>
                        </p>
                    </div>

                    <div class="flex items-center gap-3">
                        <!-- Like Button -->
                        <a href="/like/<%= post._id %>"
                            class="group/btn bg-gradient-to-r from-indigo-500/10 to-purple-500/10 hover:from-indigo-500 hover:to-purple-500 border border-purple-500/30 hover:border-transparent text-purple-400 hover:text-white font-medium text-sm rounded-lg px-4 py-2 transition-all duration-300 shadow-[0_0_12px_rgba(139,92,246,0.05)] hover:shadow-[0_0_15px_rgba(139,92,246,0.4)] flex items-center gap-2">
                            <svg class="w-4 h-4 transition-transform group-hover/btn:scale-110" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                                </path>
                            </svg>

                            <%= post.likes.some(id=> id?.toString() === user?._id?.toString()) ? 'Unlike' : 'Like' %>

                                <span
                                    class="flex items-center justify-center min-w-[20px] h-5 px-1.5 ml-1 rounded-md text-xs font-bold bg-purple-500/20 text-purple-300 group-hover/btn:bg-white/20 group-hover/btn:text-white transition-colors">
                                    <%= post.likes.length %>
                                </span>
                        </a>

                        <!-- Edit Button -->
                        <a href="/edit/<%= post._id %>"
                            class="group/editbtn bg-gradient-to-r from-gray-500/10 to-slate-500/10 hover:from-gray-600 hover:to-slate-600 border border-gray-600/30 hover:border-transparent text-gray-400 hover:text-white font-medium text-sm rounded-lg px-4 py-2 transition-all duration-300 shadow-[0_0_12px_rgba(156,163,175,0.05)] hover:shadow-[0_0_15px_rgba(156,163,175,0.3)] flex items-center gap-2">
                            <svg class="w-4 h-4 transition-transform group-hover/editbtn:scale-110" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                </path>
                            </svg>
                            Edit
                        </a>
                    </div>
                </div>
            </div>
            <% }) %>
    </main>

    <footer class="bg-gray-900 border-t border-gray-800 py-6 text-center text-sm text-gray-500 mt-auto">
        <p>System initialized for Developer Idea Board.</p>
    </footer>

</body>

</html>