<!-- views/feed.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Developer Idea Board - Public Feed</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-950 min-h-screen p-8 relative text-zinc-300 selection:bg-indigo-500/30 overflow-hidden">

    <!-- Ambient background glow -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[600px] h-[500px] bg-indigo-600/10 blur-[120px] pointer-events-none rounded-full z-0"></div>

    <div class="max-w-2xl mx-auto relative z-10">
        <h1 class="text-3xl font-light text-zinc-100 mb-10 text-center tracking-wider">Community Ideas</h1>

        <!-- Scrolling container with hidden scrollbar for a cleaner minimalist look -->
        <div class="flex flex-col gap-6 overflow-y-auto max-h-[75vh] px-2 pb-10 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
            
            <% if (ideas.length > 0) { %>
                <% ideas.forEach(idea => { %>
                    <!-- Glassmorphism Card: Semi-transparent bg, blur, thin border, smooth transition -->
                    <div class="p-7 rounded-2xl bg-zinc-900/40 border border-zinc-800/60 backdrop-blur-md hover:bg-zinc-900/70 transition-all duration-500 hover:shadow-[0_0_30px_rgba(99,102,241,0.06)] hover:border-indigo-500/20 group">
                        
                        <h2 class="text-xl font-medium text-zinc-100 group-hover:text-indigo-400 transition-colors duration-300 tracking-wide">
                            <%= idea.heading %>
                        </h2>
                        
                        <p class="text-zinc-400 mt-4 font-light leading-relaxed">
                            <%= idea.content %>
                        </p>
                        
                        <div class="flex justify-between items-center mt-8 pt-5 border-t border-zinc-800/50 text-sm">
                            <div class="flex items-center gap-2 text-zinc-500">
                                <span class="font-light">Posted by</span> 
                                <span class="font-medium text-zinc-300">@<%= idea.user ? idea.user.username : 'Unknown' %></span>
                            </div>
                            
                            <!-- Ambient Badge -->
                            <span class="flex items-center gap-2 bg-indigo-500/10 text-indigo-300 px-4 py-1.5 rounded-full border border-indigo-500/20 shadow-[0_0_15px_rgba(99,102,241,0.05)] font-medium">
                                <svg class="w-4 h-4 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                </svg>
                                <%= idea.likes ? idea.likes.length : 0 %>
                            </span>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <!-- Minimalist Empty State -->
                <div class="flex flex-col items-center justify-center py-24 border border-zinc-800/50 rounded-2xl bg-zinc-900/20 border-dashed backdrop-blur-sm shadow-inner">
                    <p class="text-zinc-500 font-light text-lg mb-2">The board is quietly waiting.</p>
                    <p class="text-indigo-400/80 font-medium tracking-wide">Be the first to post an idea.</p>
                </div>
            <% } %>
            
        </div>
    </div>

</body>
</html>